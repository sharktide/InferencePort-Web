{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash build.sh",
  "outputDirectory": "dist",
  "installCommand": "echo 'Using root buildCommand instead'",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Permissions-Policy", "value": "payment=()" }
      ]
    },
    {
      "source": "/(authcallback|authcallback\\.html|reset\\.html|openapp\\.html|verifyemail\\.html)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/solutions.html",
      "destination": "/platform.html",
      "permanent": false
    },
    {
      "source": "/solutions",
      "destination": "/platform.html",
      "permanent": false
    },
    {
      "source": "/chat",
      "destination": "https://sharktide-chat.hf.space",
      "permanent": false
    },
    {
      "source": "/chat/",
      "destination": "https://sharktide-chat.hf.space",
      "permanent": false
    },
    {
      "source": "/chat/:path*",
      "destination": "https://sharktide-chat.hf.space/:path*",
      "permanent": false
    },
    {
      "source": "/oauth/authorize",
      "destination": "https://dpixehhdbtzsbckfektd.supabase.co/auth/v1/oauth/authorize",
      "permanent": false
    },
    {
      "source": "/:path((?!index\\.html|redirect\\.html)(?!.*\\.(?:css|js|png|ico)$).*)",
      "has": [
        { "type": "host", "value": "inference.js.org" }
      ],
      "destination": "https://inferenceport.ai/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ip-api/(.*)",
      "destination": "https://api.inferenceport.ai/$1"
    },
    {
      "source": "/v1/(.*)",
      "destination": "https://api.inferenceport.ai/v1/$1"
    },
    {
      "source": "/MISC/(.*)",
      "destination": "https://raw.githubusercontent.com/sharktide/inferenceport-ai/refs/heads/main/MISC/$1"
    },
    {
      "source": "/authcallback",
      "destination": "authcallback.html"
    },
    {
      "source": "/console",
      "destination": "/console/"
    },
    {
      "source": "/console/:path*",
      "destination": "/console/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/img/favicon.ico"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        { "type": "host", "value": "console.inferenceport.ai" }
      ],
      "dest": "/console/$1"
    },
    {
      "src": "^/(|index\\.html|redirect\\.html)$",
      "has": [
        { "type": "host", "value": "inference.js.org" }
      ],
      "dest": "/redirect.html"
    }
  ]
}
